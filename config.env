# =============================================================
# config.env - valores compartilhados por TODOS os scripts
# =============================================================

# --- Domínio ---
DOMINIO="cardeal.local"

# --- Rede interna (LAN) ---
REDE="192.168.10.0"
MASCARA="255.255.255.0"
PREFIXO="24"                  # /24 = mesma coisa que 255.255.255.0
BROADCAST="192.168.10.255"

# --- IPs fixos dos servidores ---
IP_GW="192.168.10.1"          # gateway + DHCP + DNS
IP_SRV="192.168.10.10"        # Apache + Samba
IP_MAIL="192.168.10.20"       # Postfix + Dovecot

# --- Faixa do DHCP (só para clientes) ---
DHCP_INICIO="192.168.10.100"
DHCP_FIM="192.168.10.200"

# --- Nomes das placas de rede ---
# No gw: placa 1 do VirtualBox = NAT, placa 2 = Rede Interna
IF_WAN="enp0s3"
IF_LAN="enp0s8"
# Nas outras VMs (só uma placa, na Rede Interna)
IF_UNICA="enp0s3"

# --- DNS externo (para onde o BIND repassa nomes da internet) ---
DNS_EXTERNO="8.8.8.8"

# --- Nome da Rede Interna no VirtualBox ---
REDE_VBOX="cardeal-lan"
